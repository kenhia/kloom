	"connections": [
		{
			"to": "western-civ/scriptorium",
			"why": "Cassiodorus, who had served the Gothic king of Italy after the western empire ended, founded the monastery of Vivarium, where monks copied the books that carried Latin learning through."
		},
		{
			"to": "nursing/monastic-infirmary",
			"why": "Benedict wrote his Rule around 530 in an Italy ruled by Goths, and the monasteries it organized were among the institutions that outlasted the western empire."
		},
		{
			"to": "western-civ/pantheon",
			"why": "The Pantheon's reading says the skill of building like Rome faded in the West when the empire broke up; Ward-Perkins' evidence of mortared walls and tiled roofs giving way to wood and thatch is the same loss in ordinary houses."
		}
	],
