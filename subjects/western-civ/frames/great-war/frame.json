	"connections": [
		{
			"to": "chemistry/chemical-warfare",
			"why": "The chlorine released at Ypres on 22 April 1915 was Germany's first mass use of poison gas on the Western Front; the chemistry frame shows why the cloud sank into the trenches."
		},
		{
			"to": "chemistry/haber-bosch",
			"why": "Cut off from Chilean nitrate by the British blockade, Germany made the nitrates for its explosives from Haber process ammonia throughout the war."
		},
		{
			"to": "nursing/wwi-nurses",
			"why": "The US Army Nurse Corps grew from 403 nurses to more than 21,000 for this war, and the influenza of 1918 killed more of its nurses than the enemy did."
		},
		{
			"to": "blood/robertson-depot",
			"why": "Robertson laid in the first store of blood kept on ice for a British attack on the Western Front in 1917, at a casualty clearing station behind the trenches."
		}
