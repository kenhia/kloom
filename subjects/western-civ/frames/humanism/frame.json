	"connections": [
		{
			"to": "western-civ/scriptorium",
			"why": "The humanists' new book hand was a revival of the Caroline minuscule of Charlemagne's scribes, which they took for ancient Roman writing, and the oldest copy of Lucretius they recovered came from a Carolingian scriptorium."
		},
		{
			"to": "western-civ/erasmus-greek-nt",
			"why": "Erasmus learned Greek from the grammar Chrysoloras brought to Florence, and his collation of manuscripts to recover the original text was the humanists' method turned on the New Testament."
		},
		{
			"to": "chemistry/four-elements",
			"why": "The atomists' own books are lost; their atoms and void reached the Renaissance chiefly through Lucretius's poem, which Poggio Bracciolini found in a German monastery in 1417."
		}
	],
