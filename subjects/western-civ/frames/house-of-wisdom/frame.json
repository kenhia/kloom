	"connections": [
		{
			"to": "mathematics/al-khwarizmi",
			"why": "Al-Khwarizmi wrote his algebra in Baghdad under al-Ma'mun, the caliph whose court sponsored the translations this frame describes."
		},
		{
			"to": "blood/galen",
			"why": "Hunayn ibn Ishaq and his circle put Galen's books into Syriac and Arabic, the road by which they became the core of medicine in the Islamic world and then in Latin Europe."
		},
		{
			"to": "physics/ibn-al-haytham",
			"why": "Ibn al-Haytham earned his keep in Cairo copying the Arabic translations of Euclid's Elements and the Almagest that the translation movement had made, and his optics argued with them."
		},
		{
			"to": "physics/ptolemy",
			"why": "Ptolemy's treatise was put into Arabic in Baghdad around 829, and its name came down through Arabic as the Almagest."
		},
		{
			"to": "mathematics/euclid-elements",
			"why": "Euclid's Elements was translated into Arabic twice in Baghdad by al-Hajjaj ibn Matar, and it was from Arabic that it first reached Latin Europe."
		},
		{
			"to": "chemistry/jabir",
			"why": "The Jabirian treatises quote Greek philosophy that Baghdad's translators put into Arabic only late in the ninth century, which is how Paul Kraus dated them."
		}
	]
