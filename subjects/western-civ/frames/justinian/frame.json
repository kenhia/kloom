	"connections": [
		{
			"to": "western-civ/pantheon",
			"why": "Hagia Sophia's dome stands on four piers and four pendentives where the Pantheon's stands on a solid drum of wall: two ways Roman builders put a dome over a room."
		},
		{
			"to": "mathematics/apollonius-conics",
			"why": "Eutocius of Ascalon, whose commentary kept the first four books of the Conics alive in Greek, dedicated it to Anthemius of Tralles, the geometer who designed Hagia Sophia."
		},
		{
			"to": "western-civ/black-death",
			"why": "Ancient DNA shows the Plague of Justinian was Yersinia pestis, the bacterium of the Black Death."
		}
	],
