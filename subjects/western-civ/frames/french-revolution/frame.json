		{
			"to": "western-civ/metre-survey",
			"why": "The decimal measures the Revolution made law rest on the meridian survey from Dunkirk to Barcelona that Delambre and Méchain carried through the Revolution and the Terror."
		},
		{
			"to": "chemistry/lavoisier",
			"why": "Antoine Lavoisier, who remade chemistry in the year the Bastille fell and sat on the commission that made the metric system, was guillotined in the Terror as a former tax farmer."
		},
		{
			"to": "computing/prony-tables",
			"why": "Revolutionary France's decimal measures, the hundred-grade right angle among them, set Gaspard de Prony to manufacturing logarithm tables by the division of labor."
		}
