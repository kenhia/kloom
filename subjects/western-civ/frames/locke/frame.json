		{
			"to": "western-civ/royal-society",
			"why": "Locke, a physician and experimental philosopher, was elected a Fellow of the Royal Society in 1668, three years after its Philosophical Transactions began."
		},
		{
			"to": "chemistry/boyle",
			"why": "Before he wrote on government, Locke worked with Robert Boyle at Oxford as a physician and experimental philosopher."
		},
		{
			"to": "physics/principia",
			"why": "In exile in Holland Locke read Newton's Principia and asked Huygens whether its mathematics could be trusted; his Essay calls him \"the incomparable Mr. Newton\"."
		},
		{
			"to": "western-civ/american-revolution",
			"why": "Locke's \"long train of abuses\" and government by consent reappear in the Declaration of Independence."
		},
		{
			"to": "western-civ/glorious-revolution",
			"why": "Locke published the Two Treatises in 1689 to defend King William's title \"in the consent of the people\"."
		}
	],
