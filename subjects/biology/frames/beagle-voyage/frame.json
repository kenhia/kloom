	},
	"connections": [
		{
			"to": "western-civ/harrison-chronometer",
			"why": "The Beagle carried twenty-two marine chronometers to find longitude by Greenwich time, the method Harrison's H4 proved at sea in 1761."
		},
		{
			"to": "food/lind-scurvy",
			"why": "The Beagle sailed in 1831 with lemon juice among its antiscorbutics, the ration the Admiralty adopted in 1795 after the trials that began with Lind's."
		},
		{
			"to": "food/appert-canning",
			"why": "FitzRoy stowed a very large quantity of Kilner and Moorsom's preserved meat, vegetables and soup in tins, food sealed and heated as Appert and Durand had first done."
		},
		{
			"to": "western-civ/abolition",
			"why": "At Bahia in 1832 Darwin quarreled with FitzRoy over Brazilian slavery, the year before Parliament's Slavery Abolition Act; Brazil kept slavery until 1888."
		},
		{
			"to": "biology/humboldt",
			"why": "Darwin had copied out long passages of Humboldt's Personal Narrative at Cambridge, and wrote from Brazil in 1832, early in the voyage: \"I formerly admired Humboldt, I now almost adore him.\""
		}
	],
