		"counter": {
			"value": "10⁻⁹ g",
			"label": "of Stanley's virus crystals in a milliliter, enough to infect a plant"
		}
	},
	"connections": [
		{
			"to": "chemistry/enzymes",
			"why": "Stanley purified tobacco mosaic virus into crystals like an enzyme chemist, and shared the 1946 Nobel Prize in Chemistry with Sumner and Northrop, who had crystallized urease and pepsin."
		},
		{
			"to": "food/fertilizer",
			"why": "Beijerinck, who named the virus, had first grown the root-nodule bacteria of peas and beans in 1887–88, the bacteria whose nitrogen fixation Hellriegel and Wilfarth had shown in 1886."
		},
		{
			"to": "nursing/asepsis",
			"why": "Charles Chamberland of Pasteur's laboratory made both the autoclave that sterilized surgical dressings and the porcelain filter whose failure to stop the tobacco mosaic agent revealed viruses."
		},
		{
			"to": "biology/swan-neck-flask",
			"why": "Chamberland's porcelain filter, which let the tobacco mosaic agent through, came from Pasteur's laboratory: his flasks had kept out germs carried on dust, and his filter passed a germ smaller than any he imagined."
		}
	],
