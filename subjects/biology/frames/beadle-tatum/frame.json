	"connections": [
		{
			"to": "chemistry/enzymes",
			"why": "Garrod, Beadle and Tatum said genes act through enzymes, which Sumner and Northrop showed from 1926 to 1946 to be proteins."
		},
		{
			"to": "blood/sickle-cell",
			"why": "One gene, one enzyme became one gene, one polypeptide through sickle-cell hemoglobin, which Pauling's group in 1949 and Ingram by 1957 traced to a change in one protein chain."
		},
		{
			"to": "biology/mcclintock",
			"why": "Beadle and McClintock were fellow students in Cornell's small maize group in the 1920s, and in 1944 she came to Stanford to describe the chromosomes of Neurospora, his bread mold."
		},
		{
			"to": "biology/rediscovery",
			"why": "In 1902, two years after Mendel's rule was rediscovered, Bateson read Garrod's alkaptonuria families, in which first cousins were so often the parents, as a recessive character in Mendel's sense."
		}
	],
