	"connections": [
		{
			"to": "food/malthus",
			"why": "Both men found natural selection in Malthus: Darwin read the Essay on population in 1838, and Wallace, ill with fever in the Moluccas in 1858, remembered its \"positive checks\" and asked why some die and some live."
		},
		{
			"to": "western-civ/steam",
			"why": "Wallace's Ternate essay likens natural selection to \"the centrifugal governor of the steam engine,\" the feedback device Watt added to his engine, which corrects an irregularity almost before it shows."
		}
	],
