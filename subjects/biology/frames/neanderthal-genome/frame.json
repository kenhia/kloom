		"counter": {
			"value": "1–4%",
			"label": "of non-African genomes from Neanderthals"
		}
	},
	"connections": [
		{
			"to": "food/potato-blight",
			"why": "Kentaro Yoshida's team read the blight's genome from herbarium leaves of 1845 onward, with the damage typical of ancient DNA, and found that one strain, HERB-1, caused the famine."
		},
		{
			"to": "food/first-herds",
			"why": "Ancient DNA gave the estimate that humpless cattle descend from about 80 tamed aurochs cows, and showed that early European farmers lacked the main lactase-persistence variant."
		},
		{
			"to": "food/maize",
			"why": "The genome of a 5,310-year-old cob from the Tehuacan Valley showed maize already close to modern maize yet carrying many domestication genes in their wild form."
		},
		{
			"to": "chemistry/pcr",
			"why": "PCR made ancient DNA easy to amplify, and a contaminating trace of a living person's DNA just as easy, which is why the field built clean rooms."
		},
		{
			"to": "making/birch-tar",
			"why": "A lump of birch tar chewed 5,700 years ago kept enough of its chewer's DNA to sequence her whole genome: ancient DNA read from an artifact, not a bone."
		}
	],
