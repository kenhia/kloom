	"connections": [
		{
			"to": "physics/entropy",
			"why": "In 1862 William Thomson turned the dissipation of energy he had argued for in 1852 against Lyell's endlessly cycling earth, which he likened to a self-winding clock, and gave the crust 20 to 400 million years."
		},
		{
			"to": "chemistry/leaded-petrol",
			"why": "Clair Patterson's age of the earth from meteorite lead, 4.55 billion years in 1956, the measurement that led him to leaded petrol, finally put a number on the deep time Lyell's geology assumed."
		},
		{
			"to": "biology/darwin-wallace",
			"why": "Lyell read Wallace's Sarawak law of 1855 and urged Darwin to publish, and in 1858 he and Hooker arranged the joint reading of Darwin's and Wallace's papers at the Linnean Society."
		},
		{
			"to": "biology/beagle-voyage",
			"why": "FitzRoy gave Darwin the first volume of the Principles for the Beagle, Henslow advised him not to accept its views, and the first rocks he examined, on St. Jago, convinced him of Lyell's slow changes."
		}
	],
