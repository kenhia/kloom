	"connections": [
		{
			"to": "western-civ/printing-press",
			"why": "Gessner's Bibliotheca universalis of 1545, which tried to list every book in Latin, Greek and Hebrew, and his serial zoology, enlarged volume by volume with what readers sent in, were works only the printing press made possible."
		},
		{
			"to": "biology/aristotle-animals",
			"why": "Gessner took his title from Aristotle's History of Animals and built his own on it, quoting Aristotle first among the authors whose writings on animals he gathered and corrected."
		},
		{
			"to": "biology/herbals",
			"why": "Gessner promised that his woodcuts of animals were drawn from life, the rule Fuchs's herbal of 1542 had set for plants, and he broke it for Dürer's rhinoceros."
		}
	],
