	"connections": [
		{
			"to": "blood/blundell",
			"why": "Galton chose transfusion to test pangenesis in rabbits because, he wrote, it had been used with success in midwifery, the use Blundell had begun with women bleeding after childbirth."
		},
		{
			"to": "biology/preformation",
			"why": "Darwin set aside Bonnet's preformed germs, boxed one inside another, as an \"exploded\" theory: his gemmules, unlike them, were made afresh in every generation."
		},
		{
			"to": "biology/origin-of-species",
			"why": "The Origin admitted in its first chapter that \"the laws governing inheritance are quite unknown\"; pangenesis, in 1868, was Darwin's provisional attempt to supply them."
		},
		{
			"to": "biology/mendel-peas",
			"why": "Fleeming Jenkin argued in 1867 that blending inheritance would swamp any new variation; Mendel's pea experiments, published the year before but unread, answered him, while Darwin answered with gemmules."
		}
	],
