	"connections": [
		{
			"to": "western-civ/royal-society",
			"why": "Hooke wrote Micrographia as the Royal Society's Curator of Experiments, and the Society licensed and printed it two months before the first Philosophical Transactions."
		},
		{
			"to": "chemistry/boyle",
			"why": "Before he made Micrographia, Hooke was Robert Boyle's assistant at Oxford and built the air pump that frame describes."
		},
		{
			"to": "biology/cell-theory",
			"why": "Hooke named the empty boxes in cork cells in 1665 but said nothing of their being alive; the claim that every living thing is built of cells came from Schleiden and Schwann in 1838 and 1839."
		}
