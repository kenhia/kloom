	"connections": [
		{
			"to": "biology/aristotle-animals",
			"why": "Lamarck's division of 1794 into animals with and without vertebrae redrew Aristotle's line between blooded and bloodless animals, which matches it closely."
		},
		{
			"to": "western-civ/french-revolution",
			"why": "The revolutionary Convention turned the king's garden into the Paris Muséum in 1793 and gave Lamarck its new chair of insects and worms, where he founded the study of invertebrates."
		},
		{
			"to": "biology/pangenesis",
			"why": "Darwin's pangenesis of 1868 gave Lamarck's inheritance of use and disuse a mechanism, changed gemmules thrown off by changed parts; Weismann's mice, their tails cut for five generations, were the reply."
		},
		{
			"to": "biology/lysenko",
			"why": "Lysenko held, like Lamarck, that what a plant acquires from its conditions of life is inherited, and promised that chilled winter wheat would become spring wheat in two or three generations."
		}
	],
