	"connections": [
		{
			"to": "nursing/lister",
			"why": "Joseph Jackson Lister, who made the achromatic microscope practical, was the father of the surgeon Joseph Lister and guided his career."
		},
		{
			"to": "physics/prism",
			"why": "Newton concluded from his prism that a lens could never be freed of color; the achromatic doublet of crown and flint glass proved him wrong, and made the compound microscope usable."
		},
		{
			"to": "physics/atoms-real",
			"why": "Robert Brown, who named the cell nucleus in 1831, is the botanist whose jittering specks of 1827 became Brownian motion, the evidence for atoms."
		},
		{
			"to": "biology/hooke-cells",
			"why": "Hooke drew Micrographia with a compound microscope, struggling for light, and admitted a single glass bead magnified better; the compound instrument stayed that way until achromatic doublets corrected its color."
		}
	],
