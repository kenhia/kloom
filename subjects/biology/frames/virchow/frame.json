	"connections": [
		{
			"to": "western-civ/revolutions-of-1848",
			"why": "Virchow came back from the Silesian typhus epidemic to fight on the Berlin barricades in March 1848, and his maxim that politics is medicine at a larger scale was written in the revolution's journal of medical reform."
		},
		{
			"to": "biology/swan-neck-flask",
			"why": "Remak thought cells forming in a formless fluid \"as improbable as the spontaneous generation of organisms,\" and Virchow's every cell from a cell, \"just as an animal can spring only from an animal,\" made for cells the claim Pasteur's flasks made for microbes."
		},
		{
			"to": "biology/neanderthal-genome",
			"why": "Virchow judged the first Neanderthal skull a diseased modern human; in 1997 mitochondrial DNA from Neanderthal 1, the bones found in the Neander valley in 1856, fell outside the variation of 2,051 present-day people."
		}
	],
