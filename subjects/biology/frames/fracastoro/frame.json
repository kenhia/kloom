	"connections": [
		{
			"to": "western-civ/black-death",
			"why": "The quarantines of Ragusa and Venice, which the Black Death frame ends on, were already the practice when Fracastoro explained contagion by seeds carried on clothes and through the air."
		},
		{
			"to": "biology/snow-pump",
			"why": "Fracastoro's seeds of contagion stayed a hypothesis for three centuries, while physicians blamed miasma; the next contagion traced was cholera, followed by counting rather than seeing to the Broad Street pump in 1854."
		}
	],
