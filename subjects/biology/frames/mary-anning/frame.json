	"connections": [
		{
			"to": "western-civ/abolition",
			"why": "Henry De la Beche, who sold Duria Antiquior for Mary Anning's benefit, owned a Jamaican sugar estate worked by enslaved people, and the compensation for it under the 1833 abolition act went to his mortgagees."
		},
		{
			"to": "biology/cuvier-extinction",
			"why": "Shown drawings of Anning's plesiosaur in Paris, Cuvier first thought it forged from more than one animal, then came round; her sea dragons were part of the case that whole kinds of animal had vanished."
		},
		{
			"to": "biology/lyell",
			"why": "Lyell's claim that \"the ichthyosaur in the sea\" might return with the climate drew a cartoon in reply from De la Beche, who knew Anning's ichthyosaurs well: Professor Ichthyosaurus lecturing on a fossil human skull."
		}
	],
