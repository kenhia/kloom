	"connections": [
		{
			"to": "western-civ/greek-tragedy",
			"why": "Opera began as an attempt to revive Greek tragedy: Jacopo Peri's preface of 1600 says he believed the ancients sang whole tragedies on the stage, and set his Euridice to a speech-like song to match."
		},
		{
			"to": "western-civ/humanism",
			"why": "The Florentine Camerata that argued for sung drama was a circle of humanists, taking from the scholar Girolamo Mei's reading of Greek writers the belief that ancient tragedy was sung throughout."
		},
		{
			"to": "music/castrati",
			"why": "Some of Orfeo's first roles were sung by castrati, one of them borrowed from the Medici court."
		}
	],
