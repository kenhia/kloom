	"connections": [
		{
			"to": "computing/fortran",
			"why": "MUSIC I ran in 1957 on the IBM 704, the machine Fortran was written for that year, and Mathews's MUSIC III of 1961 took its wave shapes from Fortran subprograms."
		},
		{
			"to": "physics/shannon-entropy",
			"why": "Mathews cited Shannon's 1948 paper for why 20,000 samples a second can carry sound up to 10,000 cycles: the sampling theorem is its Theorem 13."
		},
		{
			"to": "computing/transistor",
			"why": "John R. Pierce, who named the transistor at Bell Labs, was the boss who dared Mathews to make a computer play music."
		},
		{
			"to": "music/fm-synthesis",
			"why": "Chowning read Mathews's 1963 paper in Science and set up at Stanford with his help."
		}
	],
