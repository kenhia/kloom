	"connections": [
		{
			"to": "western-civ/beethoven-ninth",
			"why": "The compact disc's 74-minute length was said to have been set so that one disc could hold the whole of Beethoven's Ninth, a story the CD's own engineer, Kees Schouhamer Immink, disputes."
		},
		{
			"to": "physics/young-slits",
			"why": "A CD player reads its pits by the interference of light that Young demonstrated: light from a pit's top returns half a wavelength out of step with light from the land around it, and the two cancel."
		},
		{
			"to": "physics/shannon-entropy",
			"why": "The CD was the first mass-market product to carry full error correction, the kind of code Shannon's 1948 theorem showed could make a noisy channel nearly error-free."
		}
	],
