	"connections": [
		{
			"to": "western-civ/beethoven-ninth",
			"why": "Wagner conducted Beethoven's Ninth to lay Bayreuth's foundation stone in 1872, and the festival reopened in 1951 with Furtwängler's Ninth, the recording that frame names in the story of the compact disc."
		},
		{
			"to": "western-civ/unification",
			"why": "Wagner asked the German Empire proclaimed in 1871 to pay for his theater and was refused, though its emperor, Wilhelm I, came to the Ring's first night in 1876."
		},
		{
			"to": "western-civ/holocaust",
			"why": "Of the Bayreuth Festival's Jewish artists persecuted after 1933, twelve were murdered in the Holocaust, among them its Erda, Ottilie Metzger, at Auschwitz."
		}
	],
