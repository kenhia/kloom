	"connections": [
		{
			"to": "mathematics/incommensurable",
			"why": "The Pythagoreans who held that whole numbers lay at the heart of everything took the musical concords, ratios of 1 to 4, as their chief example; the diagonal of a square was the length no such ratio could measure."
		},
		{
			"to": "physics/kepler",
			"why": "Kepler found his third law while writing the Harmonices Mundi of 1619, his search for the music of the spheres that Plato and the Pythagoreans had heard in the heavens."
		},
		{
			"to": "music/hurrian-hymn",
			"why": "The Babylonian tuning texts behind the hymn are read as a diatonic scale, a reading warned against as borrowed from the later Greek theory of ratios this frame begins."
		},
		{
			"to": "music/ellis-cents",
			"why": "The Pythagorean comma of about 23.5 cents is measured in Ellis's unit of 1885."
		}
	],
