	"connections": [
		{
			"to": "physics/ptolemy",
			"why": "Copernicus's dislike of Ptolemy's equant, the device the Almagest used to fit the planets, was his first reason for putting the Sun at the centre."
		},
		{
			"to": "western-civ/printing-press",
			"why": "De revolutionibus reached its readers as a printed book: Rheticus showed Copernicus what German presses could print, Petreius ran off some four hundred copies in Nuremberg, and 276 survive."
		}
	]
