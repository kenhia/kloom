	"connections": [
		{
			"to": "physics/aristotle-motion",
			"why": "Galileo's two tied stones turned Aristotle's rule that heavier bodies fall faster against itself, and put the difference between feather and stone down to the medium Aristotle's rules were written for."
		},
		{
			"to": "western-civ/moon-landing",
			"why": "On the Moon Apollo 11 reached, the Apollo 15 crew dropped a hammer and a feather in 1971, and with no air they landed together as Galileo had said."
		},
		{
			"to": "physics/merton-calculators",
			"why": "Galileo's times-squared law is the Merton mean speed theorem applied to free fall, which that frame proves with Oresme's triangle."
		}
	]
