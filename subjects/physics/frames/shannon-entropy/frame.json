	"connections": [
		{
			"to": "ai/laws-of-thought",
			"why": "Shannon's 1937 thesis made Boole's two values into relay switches; his 1948 paper made the two-way choice such a switch holds the unit of information, the bit."
		},
		{
			"to": "ai/next-token",
			"why": "Shannon measured the entropy of English in 1951 by having people guess the next letter; a language model is trained on the same guessing game, scored by the same logarithm, its cross-entropy."
		},
		{
			"to": "ai/boltzmann-machine",
			"why": "The Boltzmann distribution the machine samples from is, as Jaynes argued in 1957, the distribution of greatest Shannon entropy for a given average energy."
		}
