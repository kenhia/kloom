	"connections": [
		{
			"to": "computing/transistor",
			"why": "Brattain's point contacts worked by injecting holes, the positive carriers of a nearly full band that Peierls had explained in 1929; Brattain had also been in the room when Ohl's junction first lit up."
		},
		{
			"to": "computing/silicon-valley",
			"why": "Germanium transistors leaked when they should have been off, and silicon worked hotter, because silicon's band gap is wider and heat lifts far fewer electrons across it."
		},
		{
			"to": "computing/integrated-circuit",
			"why": "Lehovec isolated the parts of one chip from each other with reverse-biased p–n junctions, the barrier that lets almost no current through one way."
		}
