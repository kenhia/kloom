	"connections": [
		{
			"to": "feynman/every-path",
			"why": "The same two slits, worked through with Feynman's arrows: Young's bands are the arrows from the two slits adding and cancelling, and electrons sent one at a time build the same bands."
		},
		{
			"to": "feynman/qed-book",
			"why": "Young explained Newton's coloured rings as light reflected from the two faces of a thin film interfering, the partial reflection that Feynman's QED explains again with arrows."
		},
		{
			"to": "western-civ/maxwell",
			"why": "Young and Fresnel showed that light is a transverse wave but not what waves; Maxwell's equations of 1865 answered that it is the electromagnetic field."
		},
		{
			"to": "physics/prism",
			"why": "Young set his wave theory against Newton's corpuscles, and worked out wavelengths from Newton's own measurements of coloured rings."
		}
	]
