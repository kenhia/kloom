	"connections": [
		{
			"to": "physics/displacement-current",
			"why": "The displacement current is what lets a wave cross empty space; Maxwell's model predicted such waves in 1862, and Hertz made and measured them in 1887–88."
		},
		{
			"to": "western-civ/maxwell",
			"why": "Maxwell's frame ends with Hertz confirming his waves and Heaviside writing his equations as four; this one tells how the waves were made and the equations cut down."
		},
		{
			"to": "feynman/radio-boy",
			"why": "Hertz's ring detector answered best when it was tuned to his oscillator; the crystal set Feynman built as a boy picks out a station by the same resonance, in waves of the kind Hertz first made."
		}
	]
