	"connections": [
		{
			"to": "feynman/simulating-physics",
			"why": "Feynman asked for a computer built from quantum parts because 2ⁿ amplitudes defeat an ordinary one; qubits, unitary gates and entanglement are the physics of how such a machine holds and steers them."
		},
		{
			"to": "feynman/quantum-computers",
			"why": "Every quantum gate is unitary and so reversible, which is why Feynman could assemble his 1985 quantum machine from the reversible NOT, controlled NOT and Toffoli gates."
		},
		{
			"to": "physics/superconductivity",
			"why": "The transmon qubit is a Josephson junction, and the 2025 Nobel Prize went for showing that such a superconducting circuit behaves as one quantum object."
		},
		{
			"to": "physics/reversible-computing",
			"why": "A quantum computer's gates are unitary, and so reversible, as Bennett's computation was."
		},
		{
			"to": "physics/entanglement",
			"why": "Entanglement is one of the resources a quantum computer runs on; Bell's tests showed it is real."
		}
