	"connections": [
		{
			"to": "feynman/backwards-in-time",
			"why": "Dirac's full sea of negative-energy electrons predicted the positron; Feynman's 1949 paper reached the same answers by treating the positron as an electron running backwards in time, with no sea at all."
		},
		{
			"to": "feynman/dirac-hint",
			"why": "Both come from Dirac's effort to fit quantum mechanics to relativity: the equation of 1928, whose negative energies led him to the anti-electron, and the Lagrangian paper of 1932, which he favored because the action is the same for every observer."
		}
	]
