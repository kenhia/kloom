		{
			"to": "western-civ/jwst",
			"why": "Webb looks in the infrared because the expansion Slipher's redshifts and Hubble's diagram first revealed has stretched the light of the earliest galaxies out of the visible."
		},
		{
			"to": "physics/ptolemy",
			"why": "Ptolemy gave the universe a size, twenty thousand Earth radii to the stars; Leavitt's Cepheids and Hubble's distances replaced it with galaxies millions of light-years away."
		},
		{
			"to": "physics/general-relativity",
			"why": "Friedmann and Lemaître found the expanding universe as solutions of Einstein's equations before Hubble saw it."
		},
		{
			"to": "physics/spectra",
			"why": "The redshifts that measure the expansion are shifts of spectral lines, Fraunhofer's and Kirchhoff's."
		}
