	"connections": [
		{
			"to": "physics/x-rays",
			"why": "Von Laue's experiment of 1912 proved Röntgen's rays to be waves far shorter than light's, and the Braggs turned their diffraction by crystals into a way of reading where the atoms sit."
		},
		{
			"to": "mathematics/groups",
			"why": "The symmetries of a crystal form a group, closed under doing one move after another; Fedorov and Schoenflies counted 230 such space groups in 1891, and crystallographers classify every structure by one."
		},
		{
			"to": "chemistry/penicillin",
			"why": "Dorothy Hodgkin worked out penicillin's structure, with its strained β-lactam ring, by X-ray crystallography."
		}
	]
