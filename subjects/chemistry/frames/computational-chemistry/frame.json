	"connections": [
		{
			"to": "mathematics/monte-carlo",
			"why": "The Metropolis rule of 1953 was first put to a chemical question: the equation of state of 224 hard disks, sampled on the MANIAC by accepting each random move with its Boltzmann weight."
		},
		{
			"to": "feynman/simulating-physics",
			"why": "Kohn's exponential wall, p to the power 3N numbers for N electrons, is the chemist's form of the 2ᴺ amplitudes for N spins that made Feynman ask for a quantum computer."
		},
		{
			"to": "computing/edsac",
			"why": "Frank Boys and his colleagues ran the first configuration interaction calculations on molecules on EDSAC in the 1950s, part of the theoretical chemistry that followed its first users."
		},
		{
			"to": "chemistry/quantum-chemistry",
			"why": "The equations of quantum chemistry could be solved exactly only for the smallest molecules, and computers took over from there."
		}
	]
