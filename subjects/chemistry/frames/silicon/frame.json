	"connections": [
		{
			"to": "computing/transistor",
			"why": "The single crystals Gordon Teal pulled at Bell Labs, by Czochralski's method, made the junction transistor practical in 1951."
		},
		{
			"to": "computing/silicon-valley",
			"why": "Silicon beat germanium because its transistors did not leak when off and because it grows a stable oxide, the mask and seal of the planar process."
		},
		{
			"to": "physics/solids",
			"why": "One phosphorus atom in five million cuts silicon's resistivity half a million times, which is why silicon has to be purified to one stray atom in a billion before it is doped."
		},
		{
			"to": "western-civ/si-redefinition",
			"why": "The kilogram's redefinition leaned on counting the atoms in near-perfect spheres of silicon-28, whose stray carbon and boron atoms were measured and weighed out of the count."
		}
	]
