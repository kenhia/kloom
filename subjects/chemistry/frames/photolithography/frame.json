	"connections": [
		{
			"to": "computing/integrated-circuit",
			"why": "Planar chips were printed photographically, every chip on a wafer at once, through photoresists like the one Lathrop and Nall first used to shape transistors in 1957."
		},
		{
			"to": "computing/end-of-scaling",
			"why": "The 13.5 nm extreme-ultraviolet light that prints the finest chips of the 2020s brings about fourteen times fewer photons for the same dose, and chemically amplified resists turn each one into many reactions."
		}
	]
