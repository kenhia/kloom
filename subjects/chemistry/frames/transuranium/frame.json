	"connections": [
		{
			"to": "physics/fission",
			"why": "Fermi's claim of element 93 in 1934 was mostly uranium splitting, and the real element 93 turned up in 1940 in McMillan's experiment on how far fission fragments fly."
		},
		{
			"to": "physics/manhattan-project",
			"why": "The Manhattan Project's Hanford reactors made the plutonium, and chemists separated it with the two oxidation states Seaborg's group had found on microgram traces in 1941."
		},
		{
			"to": "feynman/trinity",
			"why": "The plutonium separated at Hanford reached Los Alamos in February 1945 and was the core of the implosion device tested at Trinity."
		},
		{
			"to": "chemistry/technetium",
			"why": "Segrè, who found element 43 because it behaved like rhenium, expected element 93 to do the same and missed it."
		}
	],
