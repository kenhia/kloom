	"connections": [
		{
			"to": "food/columbian-exchange",
			"why": "Nunn and Qian's estimate that the potato accounts for 12 percent of the growth in Old World population measures the gain Smith and Parmentier argued for: more people fed from the same land."
		},
		{
			"to": "food/irish-famine",
			"why": "Smith held up potato-fed Irish laborers as proof of the root's goodness; seventy years later the dependence of Ireland's poorest third on it turned one disease into famine."
		},
		{
			"to": "western-civ/wealth-of-nations",
			"why": "The Wealth of Nations reckoned that an acre of potatoes gave three times the solid food of an acre of wheat, the arithmetic behind Europe's eighteenth-century campaigns for the potato."
		}
