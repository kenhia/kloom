	"connections": [
		{
			"to": "western-civ/vindication",
			"why": "Joseph Johnson, who published Wollstonecraft's Vindication in 1792, published Malthus's Essay in 1798, and its chief target was her widower, William Godwin."
		},
		{
			"to": "western-civ/wealth-of-nations",
			"why": "Two chapters of Malthus's Essay dispute Adam Smith's view in The Wealth of Nations that every increase in a nation's wealth adds to the funds that feed its workers."
		},
		{
			"to": "chemistry/haber-bosch",
			"why": "Crookes's warning of 1898 that the wheat-eaters would outrun the land was Malthus's argument again, and the Haber–Bosch process is much of the answer to it."
		},
		{
			"to": "food/foragers",
			"why": "Gregory Clark's claim that the average person of 1800 was no better off than a forager of 100,000 BC rests on the kind of evidence the foragers frame weighs, from Ohalo II to the Hadza."
		}
	],
