		{
			"to": "western-civ/encyclopedie",
			"why": "The Encyclopédie's fourteenth volume, issued in 1765, defined a restaurant as a medicine to restore strength; two years later its editor, Diderot, wrote of his infinite liking for the new restaurateur."
		},
		{
			"to": "western-civ/french-revolution",
			"why": "The Revolution renamed Beauvilliers's Grande Taverne de Londres for the Republic and abolished the guilds that divided cooking among trades, and was long credited, too generously, with creating the restaurant."
		}
