	"connections": [
		{
			"to": "food/lind-scurvy",
			"why": "Lind gave matched sailors one common diet and changed one thing between pairs; Hall's trial matched two diets for nutrients and changed only their processing, the order assigned at random."
		},
		{
			"to": "food/vitamins",
			"why": "The vitamins were found by asking which nutrient a food lacked; Nova's founding claim, in Monteiro's title, is that the issue is \"not food, nor nutrients, so much as processing\"."
		},
		{
			"to": "blood/louis-numerical",
			"why": "Louis's groups of bled patients were not formed by chance and differed in age; the cohort studies of ultra-processed food meet the same problem, since those who eat most of it differ in income from those who eat least."
		},
		{
			"to": "food/pure-food",
			"why": "The Food and Drug Administration, which grew out of Wiley's Bureau of Chemistry and took its name in 1930, asked in 2025 for information to write a federal definition of ultra-processed food."
		}
