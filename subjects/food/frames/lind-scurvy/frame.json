	"connections": [
		{
			"to": "western-civ/voyages",
			"why": "Magellan's men died of scurvy crossing the Pacific; two centuries later Anson's voyage lost most of its crews to the same disease, and Lind set out to cure it."
		},
		{
			"to": "blood/louis-numerical",
			"why": "Lind compared matched pairs of sailors on different remedies in 1747; Pierre Louis made counting the outcomes of groups of patients a method of medicine in Paris in the 1820s and 1830s."
		},
		{
			"to": "western-civ/harrison-chronometer",
			"why": "Cook's voyage in the Resolution of 1772–75 carried both Kendall's copy of Harrison's watch, K1, and the sauerkraut Cook credited with keeping scurvy away."
		},
		{
			"to": "food/vitamins",
			"why": "Lind's citrus cure was explained only when the antiscorbutic factor was isolated and named vitamin C in the early 1930s."
		}
