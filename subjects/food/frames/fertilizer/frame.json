	"connections": [
		{
			"to": "chemistry/haber-bosch",
			"why": "The Haber–Bosch frame tells the chemistry and the plant that made ammonia from the air; this one follows the ammonia onto the fields, where it grows about half of the world's food."
		},
		{
			"to": "western-civ/great-war",
			"why": "The British blockade of the First World War cut Germany off from Chilean nitrate, and the Haber process made its explosives instead, before it made fertilizer for the world."
		},
		{
			"to": "chemistry/gunpowder",
			"why": "Crookes warned in 1898 that running out of fixed nitrogen would mean \"even the extinction of gunpowder\", whose oxidizer, saltpeter, is a nitrate like the ones the fields needed."
		}
	],
