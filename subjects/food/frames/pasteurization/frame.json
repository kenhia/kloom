	"connections": [
		{
			"to": "chemistry/chirality",
			"why": "Before he turned to the diseases of wine, Pasteur had studied the tartrates of wine casks, and about 1857 found that fermenting microbes eat one hand of tartaric acid and leave the other."
		},
		{
			"to": "chemistry/enzymes",
			"why": "Pasteur's proof that sugar ferments only with living yeast is the theory of fermentation from which he reasoned that heat, killing the microbes, would stop wine spoiling."
		},
		{
			"to": "nursing/lister",
			"why": "Lister built antiseptic surgery on the same work of Pasteur's that gave pasteurization: that putrefaction and spoilage are caused by living germs, which can be killed."
		},
		{
			"to": "food/appert-canning",
			"why": "Pasteur granted that Nicolas Appert had first proposed keeping wine by heating it, decades before Pasteur's own patent of 1865."
		},
		{
			"to": "food/first-herds",
			"why": "The cattle's tuberculosis bacillus, found by 1902 in children who had died of the disease, was the strongest argument for heating milk."
		}
	],
