	"connections": [
		{
			"to": "physics/entropy",
			"why": "The second law, that heat never passes from colder to warmer without some other change, is why a refrigerator must spend work to pump heat out of its cold box."
		},
		{
			"to": "physics/carnot",
			"why": "Carnot's ideal cycle, run backwards, sets the most heat a refrigerator can move for each unit of work: about 5.3 for a freezer at −18 °C in a 30 °C room."
		},
		{
			"to": "chemistry/ozone-hole",
			"why": "The chlorofluorocarbons that replaced the poisonous refrigerants of the 1920s in household refrigerators were the gases that thinned the ozone layer."
		}
	],
