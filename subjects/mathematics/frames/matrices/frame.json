	"connections": [
		{
			"to": "physics/matrix-mechanics",
			"why": "Heisenberg's tables of transition amplitudes multiplied by a rule he had invented; Born recognised it as the matrix multiplication he had learned as a student, the product Cayley had shown does not commute."
		},
		{
			"to": "ai/compute",
			"why": "The chips that train and run neural networks are built around matrix multiplication: Google's first Tensor Processing Unit was, at heart, a 65,536-multiplier matrix unit."
		},
		{
			"to": "ai/self-attention",
			"why": "Self-attention is matrix algebra: each token's vector is multiplied by three learned matrices, and the scores are the product of the query and key matrices, QKᵀ."
		}
	]
