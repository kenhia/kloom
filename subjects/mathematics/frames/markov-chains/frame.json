	"connections": [
		{
			"to": "physics/shannon-entropy",
			"why": "The 1948 paper in which Shannon defined entropy built its approximations to English letter by letter from the letters before, and called them discrete Markoff processes: Markov's Onegin chain, run the other way to write."
		},
		{
			"to": "ai/next-token",
			"why": "A model that draws each token from probabilities computed on a fixed window of preceding text is a Markov chain whose state is the window: Markov's vowel-after-consonant count, grown to a vocabulary and a context."
		},
		{
			"to": "mathematics/large-numbers",
			"why": "Markov built his chains to show that Bernoulli's law of large numbers holds without independence."
		}
	]
