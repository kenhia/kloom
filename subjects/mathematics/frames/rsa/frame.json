	"connections": [
		{
			"to": "computing/security",
			"why": "The security frame works Diffie and Hellman's 1976 key exchange and tells of Cocks's secret version at GCHQ; RSA, published by Rivest, Shamir and Adleman in 1977, was the first public lock in print."
		},
		{
			"to": "computing/tls",
			"why": "TLS is how the web uses public-key cryptography today, and it is already adding ML-KEM, one of the post-quantum standards NIST published in August 2024 against a quantum attack on RSA-style keys."
		},
		{
			"to": "feynman/quantum-computing-now",
			"why": "Shor's 1994 algorithm would let a large quantum computer factor RSA's modulus; that frame charts the estimates of how many qubits a 2048-bit key would take."
		},
		{
			"to": "mathematics/prime-number-theorem",
			"why": "RSA needs large primes, and the prime number theorem says how many there are: near 2¹⁰²⁴ about one number in 710."
		},
		{
			"to": "mathematics/disquisitiones",
			"why": "RSA runs on congruences modulo n, the arithmetic Gauss set out in the Disquisitiones."
		}
