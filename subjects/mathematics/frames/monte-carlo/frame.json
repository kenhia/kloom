	"connections": [
		{
			"to": "computing/eniac",
			"why": "The Monte Carlo runs of April and May 1948 were among the first work ENIAC did after its conversion at Aberdeen to a list of numbered orders, and were argued to be the first program in the modern stored-program style ever run."
		},
		{
			"to": "physics/manhattan-project",
			"why": "The method was made at Los Alamos for the question the Manhattan Project had worked by hand and on punched-card machines: how fast neutrons multiply in a core of fissile metal."
		},
		{
			"to": "ai/alphago",
			"why": "AlphaGo's tree search judged each position it reached half by its value network and half by the result of a quickly played random game, a Monte Carlo rollout."
		}
	]
