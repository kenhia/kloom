	"connections": [
		{
			"to": "chemistry/bessemer-steel",
			"why": "The diagram's top line is Bessemer's problem: iron with 4 per cent carbon is liquid near 1,150 °C and iron with almost none only near 1,540 °C, so a converter burning out the carbon must heat itself as it goes."
		},
		{
			"to": "chemistry/gibbs-free-energy",
			"why": "Roozeboom redrew the iron–carbon diagram by Gibbs's phase rule, which is why three phases meet only on its horizontal lines, at one temperature."
		},
		{
			"to": "making/sorby-microscope",
			"why": "Pearlite is Sorby's pearly constituent, and 727 °C is where the compound Sorby guessed at breaks up."
		}
	]
