		{
			"to": "chemistry/photolithography",
			"why": "An EUV machine's 13.5 nm light arrives as about fourteen times fewer photons than 193 nm light for the same dose, so the chemically amplified resists it prints on must turn each photon into many reactions."
		},
		{
			"to": "computing/end-of-scaling",
			"why": "ASML's tin-droplet EUV machines printed the patterns of the FinFET and nanosheet transistors that kept chips shrinking after the free ride of Dennard scaling ended."
		}
