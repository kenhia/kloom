		{
			"to": "western-civ/steam",
			"why": "From 1723 Coalbrookdale cast the cylinders for Newcomen's pumping engines, the engines whose wasted heat Watt's separate condenser saved."
		},
		{
			"to": "making/dovetail",
			"why": "The Iron Bridge's ribs are joined to their radials with blind dovetails cast in iron, a carpenter's joint."
		},
		{
			"to": "making/mortise-and-tenon",
			"why": "The Iron Bridge's ribs meet its uprights in wedged mortises and tenons, cast in iron instead of cut in oak."
		}
