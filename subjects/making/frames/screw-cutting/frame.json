	"connections": [
		{
			"to": "computing/clement-fragment",
			"why": "Joseph Clement, who built Babbage's engine, began about 1828 to cut screw threads to a fixed pitch for each diameter: the first step from the change-gear lathe's freedom to cut any pitch towards a standard."
		},
		{
			"to": "making/whitworth",
			"why": "Whitworth, who had worked for Clement, proposed in 1841 the thread that became Britain's standard."
		},
		{
			"to": "making/gauge-blocks",
			"why": "The 127-tooth change gear exists because an inch is exactly 25.4 millimetres, the industrial inch Johansson's blocks fixed."
		}
	],
