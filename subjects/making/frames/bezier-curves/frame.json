	"connections": [
		{
			"to": "computing/macintosh",
			"why": "PostScript, the language that made the Mac a printing press, draws every shape, letters included, with the cubic curves de Casteljau and Bézier devised for car bodies."
		},
		{
			"to": "mathematics/apollonius-conics",
			"why": "A Bézier curve with three control points is exactly an arc of a parabola, one of Apollonius's conics, and de Casteljau said the old construction of the parabola from points and tangents inspired his."
		},
		{
			"to": "making/numerical-control",
			"why": "Bézier was put in charge of Renault's machine-tool division in 1957 to catch up with American numerical control."
		}
	],
